{
  "name": "@ferresys/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Piezas comunes del backend de las empresas y de la consola de VALETEC: contraseñas, sesiones, límite de intentos, registro y errores.",
  "type": "module",
  "exports": {
    "./errors": {
      "types": "./errors.d.ts",
      "default": "./errors.js"
